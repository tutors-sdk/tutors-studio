# Tutors Studio reads this file as .env when run headless (pnpm headless); real environment variables win.
# The desktop app keeps the same keys in this computer's keychain, set in Settings.
# Copy it to .env and fill in what you need. Never commit .env.

# A Netlify personal access token, for `pnpm headless <folder> publish <site>`.
NETLIFY_AUTH_TOKEN=
