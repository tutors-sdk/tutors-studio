# Tutors Studio reads this file as .env when run headless (pnpm headless), and Settings holds the same
# variables in the app. Generated from src/domain/environment.ts; a test keeps the two in step.
# Copy it to .env and fill in what you need. Never commit .env.

# --- Tutors reader: How the Tutors reader on this computer runs.
# TRUE runs the reader with no sign-in, presence or analytics. Leave it TRUE on this computer.
PUBLIC_ANON_MODE=TRUE
# Where links to the reader go.
PUBLIC_READER_ORIGIN=https://tutors.dev
# Where links to the course catalogue go.
PUBLIC_CATALOGUE_ORIGIN=https://catalogue.tutors.dev
# Where links to Tutors Live go.
PUBLIC_LIVE_ORIGIN=https://live.tutors.dev
# Where links to the time dashboard go.
PUBLIC_TIME_ORIGIN=https://time.tutors.dev
# The reader the time dashboard reads course time from.
PUBLIC_READER_URL=https://tutors.dev
# Hosts other than netlify.app that serve courses, comma-separated.
PRIVATE_COURSE_HOSTS=
# GitHub logins that count as an educator of every course, comma-separated.
PRIVATE_TUTORS_ADMINS=
# Origins allowed to read the reader's time API, comma-separated.
PRIVATE_API_ALLOWED_ORIGINS=https://time.tutors.dev

# --- Sign-in: Only used when anonymous mode is off: the Supabase project and GitHub app students sign in with.
# Your Supabase project's address.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Your Supabase project's public (anon) key.
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Your Supabase service-role key. It bypasses row security: keep it secret.
PRIVATE_SUPABASE_SERVICE_ROLE_KEY=
# Your GitHub OAuth app's client id.
PRIVATE_AUTH_GITHUB_ID=your-github-oauth-app-id
# Your GitHub OAuth app's client secret.
PRIVATE_AUTH_GITHUB_SECRET=your-github-oauth-app-secret
# Signs sign-in sessions; at least 32 characters.
PRIVATE_AUTH_SECRET=your-secret-key-at-least-32-chars-long

# --- Integrations: PDF viewing and Moodle.
# Adobe PDF Embed key, for showing talks with Adobe's viewer.
PUBLIC_PDF_KEY=your-adobe-pdf-key
# Your Moodle web-service address, for the educator Moodle sync.
MOODLE_WS_URL=https://your-moodle.example.com/webservice/rest/server.php
# Your Moodle web-service token.
MOODLE_WS_TOKEN=your-moodle-ws-token
# Moodle's reply format; leave it json.
MOODLE_WS_REST_FORMAT=json
# How often the Moodle sync runs, in minutes.
SYNC_INTERVAL_MINUTES=60

# --- Operations: Logs and metrics, for whoever runs the servers.
# debug, info, warn or error. Empty means the default.
LOG_LEVEL=
# When set, the metrics page needs this token.
METRICS_TOKEN=

# --- Publishing: Studio's own: where it publishes your course.
# A Netlify personal access token, for Publish to Netlify.
NETLIFY_AUTH_TOKEN=
